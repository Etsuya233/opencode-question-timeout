{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@etsuya/opencode-question-timeout",
  "version": "0.2.4",
  "description": "Shows a countdown on the OpenCode V2 question prompt and auto-answers with the first option when it runs out, so a long unattended run cannot stall on a question.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etsuya233/opencode-question-timeout.git"
  },
  "bugs": {
    "url": "https://github.com/Etsuya233/opencode-question-timeout/issues"
  },
  "homepage": "https://github.com/Etsuya233/opencode-question-timeout#readme",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/question.test.ts",
    "prepublishOnly": "npm run compile && npm run typecheck && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "question",
    "timeout",
    "countdown",
    "automation"
  ],
  "dependencies": {
    "@opencode/plugin": ">=2.0.18"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "^2.0.18",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0"
  }
}
